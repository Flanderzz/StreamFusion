<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tech.streamfusion</groupId>
    <artifactId>streamfusion-flink-suite-classpath</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- Overridden per Flink line by bin/flink-suite.sh. -->
    <properties>
        <flink.version>2.2.1</flink.version>
        <flink.line>2.2</flink.line>
        <flink.connector.kafka.version>5.0.0-2.2</flink.connector.kafka.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-core-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-kafka-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-json-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-csv-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-raw-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-avro-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-avro-confluent-registry-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-protobuf-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <dependency>
            <groupId>tech.streamfusion</groupId>
            <artifactId>streamfusion-parquet-flink${flink.line}</artifactId>
            <version>0.1.0-rc2</version>
        </dependency>
        <!-- StreamFusion discovers connector planner extensions at startup. Connector APIs are
             provided-scope in the production modules, so make Kafka's API explicit in this
             all-extensions test JVM even when the selected upstream suite is a file format. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${flink.connector.kafka.version}</version>
        </dependency>
    </dependencies>
</project>
