<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jordepic</groupId>
        <artifactId>StreamFusion</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>streamfusion-paimon-compactor</artifactId>

    <properties>
        <!-- The Apache 2.0 snapshot (snapshots published after 2026-07-29 carry the
             binary-primary-key lookup comparator fix, apache/paimon#8873) — the first Paimon
             deletion-vector state tables can run on, and deletion vectors are the canonical
             production mode for native state tables. Pin a stable release here the moment one
             ships with the fix. Overridable for older bundles, where the capability probe falls
             the backend back to merge-read tables. -->
        <paimon.bundle.version>2.0-SNAPSHOT</paimon.bundle.version>
    </properties>

    <!-- Java Paimon as the maintainer of native state tables: stock Paimon's compaction (its own
         picks, its sequence-preserving rewriter, its deletion handling) runs against the local
         table at every checkpoint barrier, replacing the native store's fallback rewrite. An
         optional deployment module in the connector-extension mold: drop this JAR plus a Paimon
         bundle (>= 1.4.1) into Flink's lib directory to enable it; without them the state backend
         works unchanged on its fallback — never a linkage failure. Both dependencies are provided:
         the runtime is already in lib, and Paimon is the user's own bundle (bundling or shading a
         second copy of org.apache.paimon would collide with it). -->
    <dependencies>
        <dependency>
            <groupId>io.github.jordepic</groupId>
            <artifactId>streamfusion-runtime</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-bundle</artifactId>
            <!-- Overridable (-Dpaimon.bundle.version=...). On bundles without the comparator
                 fix the deletion-vector tests skip via the capability probe and the backend
                 runs merge-read tables. -->
            <version>${paimon.bundle.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The runtime's test classes: the state-backend benchmark reuses the Nexmark test
             environment, and it must run in THIS module — the state tables are only maintained
             when the compactor is on the classpath, and a benchmark of unmaintained tables would
             measure a configuration the docs tell deployments not to run. -->
        <dependency>
            <groupId>io.github.jordepic</groupId>
            <artifactId>streamfusion-runtime</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The parent's resource configuration points at the repository root's resources and the
             native library tree (for the runtime module). This module carries only its own
             conventional resources — the ServiceLoader registration must land in the JAR, and the
             native library must not. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
